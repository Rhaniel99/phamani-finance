# ---------------------------------------------------------------------------
# Phamani — PRODUÇÃO (servidor marvin)
# Copie para /home/pholaroid/apps/phamani/.env.production (FORA do repositório)
# e preencha os campos marcados com <...>. Nunca faça commit deste arquivo preenchido.
# ---------------------------------------------------------------------------

APP_NAME=Phamani
APP_ENV=production
# Gere com:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://phamani.lukisa.com.br
APP_TIMEZONE=America/Manaus
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=phamani
DB_USERNAME=phamani
# Gere com:  openssl rand -hex 24
DB_PASSWORD=<senha-forte>

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# Não há worker de fila: tudo roda na hora.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Google OAuth (mesmo cliente do dev, com a URL de produção cadastrada)
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cloudflare Tunnel (Zero Trust → Networks → Tunnels → seu túnel → token)
CLOUDFLARE_TUNNEL_TOKEN=<eyJ...>

# Onde ficam os backups diários do banco (HD de 4TB)
BACKUP_DIR=/media/dados/backups/phamani

# Porta local do nginx (só 127.0.0.1, para teste no próprio servidor)
APP_PORT=8686
