# Imagens de PRODUÇÃO do Phamani (build a partir da raiz do projeto).
#
#   target "app": PHP-FPM com o código, vendor sem pacotes de dev e assets já compilados
#   target "web": nginx servindo /public (assets) e repassando o PHP para o "app"
#
# Node só existe no estágio de build: o plugin do Wayfinder chama `php artisan wayfinder:generate`
# durante o `vite build`, por isso PHP e Node ficam juntos ali.

# --- Extensões PHP (compiladas uma vez) ---------------------------------------------------------
FROM php:8.4-fpm-alpine AS php-ext
RUN apk add --no-cache $PHPIZE_DEPS postgresql-dev libzip-dev icu-dev linux-headers \
        libpng-dev libjpeg-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql bcmath intl zip pcntl opcache gd

# --- Base de runtime -----------------------------------------------------------------------------
FROM php:8.4-fpm-alpine AS base
COPY --from=php-ext /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-ext /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
RUN apk add --no-cache libzip icu-libs postgresql-libs libstdc++ tzdata libpng libjpeg-turbo libwebp
# OCR do extrato do cartão: Tesseract (inglês basta para números e nomes de loja) + Poppler (pdfimages/pdftotext)
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng poppler-utils
COPY docker/php/prod.ini /usr/local/etc/php/conf.d/zz-prod.ini
WORKDIR /var/www/html

# --- Build: vendor + assets ----------------------------------------------------------------------
FROM base AS build
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=node:24-alpine /usr/local/bin/node /usr/local/bin/node
COPY --from=node:24-alpine /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apk add --no-cache git unzip

# Dependências primeiro (camadas em cache enquanto composer.json/package-lock não mudarem)
COPY composer.json composer.lock* ./
RUN composer install --no-dev --no-interaction --no-scripts --no-autoloader --prefer-dist
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative \
    && php artisan package:discover --ansi \
    && npm run build \
    && rm -rf node_modules tests .env .env.* \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# --- App (php-fpm) -------------------------------------------------------------------------------
FROM base AS app
COPY --from=build /var/www/html /var/www/html
COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint
USER www-data
ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]

# --- Web (nginx) ---------------------------------------------------------------------------------
FROM nginx:stable-alpine AS web
COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /var/www/html/public /var/www/html/public
